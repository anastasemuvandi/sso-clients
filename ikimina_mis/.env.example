# Copy to .env and adjust for your environment. .env is gitignored.
# These are only needed if you want to override docker-compose defaults or point
# the backend at a REAL SMTP server instead of the bundled MailHog container.

# --- Database ---
DB_USERNAME=ikimina_user
DB_PASSWORD=ikimina_pass

# --- JWT (use a long, random value in production) ---
JWT_SECRET=ikimina-super-secret-key-change-in-production-must-be-256bits-long

# --- Email / SMTP ---
# Defaults target the MailHog container. For real email (e.g. Gmail) set:
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=you@gmail.com
#   MAIL_PASSWORD=your-app-password
#   MAIL_SMTP_AUTH=true
#   MAIL_SMTP_STARTTLS=true
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@ikimina.gov.rw

# --- Verification code lifetime (minutes) ---
CODE_TTL_MINUTES=10
