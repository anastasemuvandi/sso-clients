# Copy to .env and adjust for your environment. .env is gitignored.
# Most vars below just override docker-compose defaults (or point the backend at
# a REAL SMTP server). EXCEPTION: CLIENT_SECRET (Government SSO section) is
# REQUIRED — docker-compose uses ${CLIENT_SECRET:?...}, so `docker compose up`
# fails fast without a .env that sets it.

# --- Database ---
DB_USERNAME=ikimina_user
DB_PASSWORD=ikimina_pass

# --- JWT (use a long, random value in production) ---
JWT_SECRET=ikimina-super-secret-key-change-in-production-must-be-256bits-long

# --- Email / SMTP ---
# Defaults target the MailHog container. For real email (e.g. Gmail) set:
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=you@gmail.com
#   MAIL_PASSWORD=your-app-password
#   MAIL_SMTP_AUTH=true
#   MAIL_SMTP_STARTTLS=true
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@ikimina.gov.rw

# --- Verification code lifetime (minutes) ---
CODE_TTL_MINUTES=10

# --- Government SSO (OIDC) ---
# CLIENT_SECRET is REQUIRED (see note at top). Get it from the Keycloak client
# (`ikimina-portal` in the `government-internal` realm). The rest have working
# defaults in docker-compose.yml — only override to point at a different stack.
CLIENT_ID=ikimina-portal
CLIENT_SECRET=replace-with-the-ikimina-portal-client-secret
# SSO_ISSUER_URI=http://localhost:8080/realms/government-internal
# SSO_JWK_SET_URI=http://host.docker.internal:8080/realms/government-internal/protocol/openid-connect/certs
# SSO_AUTH_URI=http://localhost:8000/oauth2/authorize
# SSO_TOKEN_URI=http://host.docker.internal:8000/oauth2/token
# SSO_USERINFO_URI=http://host.docker.internal:8000/auth/userinfo
# FRONTEND_URL=http://localhost:8180
