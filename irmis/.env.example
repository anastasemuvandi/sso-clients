# Copy to .env and source it (or set these as environment variables) before
# starting the backend. .env is gitignored — never commit the real secret.
#
# Only CLIENT_SECRET is required for the Government SSO login to work. Local
# username/password login works without any of these.

# --- Government SSO (OIDC) ---
# Get the secret from the Keycloak client (`irmis-portal` in the
# `government-internal` realm) once the client is registered.
CLIENT_ID=irmis-portal
CLIENT_SECRET=replace-with-the-irmis-portal-client-secret

# --- Optional overrides (sensible defaults live in application.properties) ---
# SERVER_PORT=8200
# JWT_SECRET=irmis-super-secret-key-change-in-production-must-be-256bits-long
# FRONTEND_URL=http://localhost:8201
# SSO_ISSUER_URI=http://localhost:8080/realms/government-internal
# SSO_JWK_SET_URI=http://localhost:8080/realms/government-internal/protocol/openid-connect/certs
# SSO_AUTH_URI=http://localhost:8000/oauth2/authorize
# SSO_TOKEN_URI=http://localhost:8000/oauth2/token
# SSO_USERINFO_URI=http://localhost:8000/auth/userinfo
